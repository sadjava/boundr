POSTGRES_USER=boundr
POSTGRES_PASSWORD=boundr
POSTGRES_DB=boundr

JWT_SECRET=change-me-in-prod
INTERNAL_API_TOKEN=internal-secret

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=boundr
S3_PUBLIC_ENDPOINT=http://localhost:9000

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

TWELVELABS_API_KEY=

# OpenRouter (eval judge + marlin_gpt postprocess)
OPENROUTER_API_KEY=

# Full stack by default. Clear this (COMPOSE_PROFILES= docker compose up -d) for a
# light pegasus-only run: no llama.cpp build, no GPU, no fine-tune worker.
COMPOSE_PROFILES=marlin,finetune

# Marlin llama.cpp (profile: marlin)
MARLIN_PORT=8085
MARLIN_MODELS_DIR=./models/marlin
